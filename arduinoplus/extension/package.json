{
  "name": "arduinoplus",
  "displayName": "Arduino+",
  "description": "Essential IDE helpers for Arduino development",
  "version": "1.1.0",
  "publisher": "MonsterMaker",
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "arduino",
    "arduinoIDE",
    "comment",
    "toggle",
    "editor",
    "tools",
    "snippets",
    "anchors",
    "bookmarks",
    "navigation",
    "todo",
    "fixme"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "arduinoplus.toggleLineComment",
        "title": "%command.toggleLineComment%",
        "category": "Arduino+",
        "icon": "$(symbol-operator)"
      },
      {
        "command": "arduinoplus.copyToSnippets",
        "title": "%command.copyToSnippets%",
        "category": "Arduino+",
        "icon": "$(files)"
      },
      {
        "command": "arduinoplus.moveToSnippets",
        "title": "%command.moveToSnippets%",
        "category": "Arduino+",
        "icon": "$(arrow-right)"
      },
      {
        "command": "arduinoplus.openSnippetPanel",
        "title": "%command.openSnippetPanel%",
        "category": "Arduino+",
        "icon": "$(list-unordered)"
      },
      {
        "command": "arduinoplus.setAnchor",
        "title": "%command.setAnchor%",
        "category": "Arduino+",
        "icon": "$(bookmark)"
      },
      {
        "command": "arduinoplus.showAnchors",
        "title": "%command.showAnchors%",
        "category": "Arduino+",
        "icon": "$(list-flat)"
      },
      {
        "command": "arduinoplus.duplicateLine",
        "title": "%command.duplicateLine%",
        "category": "Arduino+",
        "icon": "$(files)"
      },
      {
        "command": "arduinoplus.about",
        "title": "%command.about%",
        "category": "Arduino+",
        "icon": "$(info)"
      },
      {
        "command": "arduinoplus.insertSnippet",
        "title": "%command.insertSnippet%",
        "category": "Arduino+",
        "icon": "$(clippy)"
      },
      {
        "command": "arduinoplus.insertCommentAnchor",
        "title": "%command.insertCommentAnchor%",
        "category": "Arduino+",
        "icon": "$(comment)"
      },
      {
        "command": "arduinoplus.showTodos",
        "title": "%command.showTodos%",
        "category": "Arduino+",
        "icon": "$(checklist)"
      }
    ],
    "keybindings": [
      {
        "command": "arduinoplus.toggleLineComment",
        "key": "ctrl+/",
        "mac": "cmd+/",
        "when": "editorTextFocus"
      },
      {
        "command": "arduinoplus.setAnchor",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b",
        "when": "editorTextFocus"
      },
      {
        "command": "arduinoplus.showAnchors",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a",
        "when": "editorTextFocus"
      },
      {
        "command": "arduinoplus.duplicateLine",
        "key": "ctrl+shift+d",
        "mac": "cmd+shift+d",
        "when": "editorTextFocus"
      },
      {
        "command": "arduinoplus.insertSnippet",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "arduinoplus.toggleLineComment",
          "group": "1_arduinoplus@1"
        },
        {
          "command": "arduinoplus.duplicateLine",
          "group": "1_arduinoplus@2"
        },
        {
          "command": "arduinoplus.copyToSnippets",
          "group": "1_arduinoplus@3",
          "when": "editorHasSelection"
        },
        {
          "command": "arduinoplus.moveToSnippets",
          "group": "1_arduinoplus@4",
          "when": "editorHasSelection"
        },
        {
          "command": "arduinoplus.insertSnippet",
          "group": "1_arduinoplus@5"
        },
        {
          "command": "arduinoplus.openSnippetPanel",
          "group": "1_arduinoplus@6"
        },
        {
          "command": "arduinoplus.setAnchor",
          "group": "1_arduinoplus@7"
        },
        {
          "command": "arduinoplus.insertCommentAnchor",
          "group": "1_arduinoplus@8"
        },
        {
          "command": "arduinoplus.showAnchors",
          "group": "1_arduinoplus@9"
        },
        {
          "command": "arduinoplus.showTodos",
          "group": "1_arduinoplus@10"
        },
        {
          "command": "arduinoplus.about",
          "group": "2_arduinoplus@1"
        }
      ]
    }
  },
  "scripts": {
    "package": "vsce package"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NikolaiRadke/Arduinoplus"
  },
  "license": "Apache-2.0"
}
