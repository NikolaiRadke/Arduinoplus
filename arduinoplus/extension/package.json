{
  "name": "arduinoplus",
  "displayName": "Arduino+",
  "description": "Essential IDE helpers for Arduino development",
  "version": "1.2.0",
  "publisher": "NikolaiRadke",
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#2bc4b6",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Other",
    "Snippets",
    "Education"
  ],
  "keywords": [
    "arduino",
    "arduinoIDE",
    "comment",
    "toggle",
    "editor",
    "tools",
    "snippets",
    "anchors",
    "bookmarks",
    "navigation",
    "todo",
    "fixme",
    "hex",
    "binary",
    "lcd",
    "createChar",
    "bitmap",
    "oled",
    "u8g2",
    "snapshot",
    "backup",
    "history",
    "color",
    "rgb565",
    "neopixel",
    "melody",
    "tone",
    "rtttl",
    "print"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "arduinoplus.toggleLineComment",
        "title": "%command.toggleLineComment%",
        "category": "Arduino+",
        "icon": "$(symbol-operator)"
      },
      {
        "command": "arduinoplus.copyToSnippets",
        "title": "%command.copyToSnippets%",
        "category": "Arduino+",
        "icon": "$(files)"
      },
      {
        "command": "arduinoplus.moveToSnippets",
        "title": "%command.moveToSnippets%",
        "category": "Arduino+",
        "icon": "$(arrow-right)"
      },
      {
        "command": "arduinoplus.openSnippetPanel",
        "title": "%command.openSnippetPanel%",
        "category": "Arduino+",
        "icon": "$(list-unordered)"
      },
      {
        "command": "arduinoplus.setAnchor",
        "title": "%command.setAnchor%",
        "category": "Arduino+",
        "icon": "$(bookmark)"
      },
      {
        "command": "arduinoplus.showAnchors",
        "title": "%command.showAnchors%",
        "category": "Arduino+",
        "icon": "$(list-flat)"
      },
      {
        "command": "arduinoplus.duplicateLine",
        "title": "%command.duplicateLine%",
        "category": "Arduino+",
        "icon": "$(files)"
      },
      {
        "command": "arduinoplus.about",
        "title": "%command.about%",
        "category": "Arduino+",
        "icon": "$(info)"
      },
      {
        "command": "arduinoplus.insertSnippet",
        "title": "%command.insertSnippet%",
        "category": "Arduino+",
        "icon": "$(clippy)"
      },
      {
        "command": "arduinoplus.insertCommentAnchor",
        "title": "%command.insertCommentAnchor%",
        "category": "Arduino+",
        "icon": "$(comment)"
      },
      {
        "command": "arduinoplus.showTodos",
        "title": "%command.showTodos%",
        "category": "Arduino+",
        "icon": "$(checklist)"
      },
      {
        "command": "arduinoplus.convertNumber",
        "title": "%command.convertNumber%",
        "category": "Arduino+",
        "icon": "$(symbol-numeric)"
      },
      {
        "command": "arduinoplus.lcdCharEditor",
        "title": "%command.lcdCharEditor%",
        "category": "Arduino+",
        "icon": "$(symbol-color)"
      },
      {
        "command": "arduinoplus.snapshots",
        "title": "%command.snapshots%",
        "category": "Arduino+",
        "icon": "$(history)"
      },
      {
        "command": "arduinoplus.colorPicker",
        "title": "%command.colorPicker%",
        "category": "Arduino+",
        "icon": "$(symbol-color)"
      },
      {
        "command": "arduinoplus.melodyEditor",
        "title": "%command.melodyEditor%",
        "category": "Arduino+",
        "icon": "$(music)"
      },
      {
        "command": "arduinoplus.print",
        "title": "%command.print%",
        "category": "Arduino+",
        "icon": "$(file-pdf)"
      }
    ],
    "keybindings": [
      {
        "command": "arduinoplus.toggleLineComment",
        "key": "ctrl+/",
        "mac": "cmd+/",
        "when": "editorTextFocus && !arduinoplus.isVSCode"
      },
      {
        "command": "arduinoplus.setAnchor",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b",
        "when": "editorTextFocus && !arduinoplus.isVSCode"
      },
      {
        "command": "arduinoplus.showAnchors",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a",
        "when": "editorTextFocus && !arduinoplus.isVSCode"
      },
      {
        "command": "arduinoplus.duplicateLine",
        "key": "ctrl+shift+d",
        "mac": "cmd+shift+d",
        "when": "editorTextFocus && !arduinoplus.isVSCode"
      },
      {
        "command": "arduinoplus.insertSnippet",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorTextFocus"
      }
    ],
    "submenus": [
      {
        "id": "arduinoplus.menu",
        "label": "Arduino+"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "arduinoplus.menu",
          "group": "1_arduinoplus@1"
        }
      ],
      "arduinoplus.menu": [
        {
          "command": "arduinoplus.toggleLineComment",
          "group": "1_edit@1",
          "when": "!arduinoplus.isVSCode"
        },
        {
          "command": "arduinoplus.duplicateLine",
          "group": "1_edit@2",
          "when": "!arduinoplus.isVSCode"
        },
        {
          "command": "arduinoplus.convertNumber",
          "group": "1_edit@3"
        },
        {
          "command": "arduinoplus.colorPicker",
          "group": "1_edit@4"
        },
        {
          "command": "arduinoplus.copyToSnippets",
          "group": "2_snippets@1",
          "when": "editorHasSelection"
        },
        {
          "command": "arduinoplus.moveToSnippets",
          "group": "2_snippets@2",
          "when": "editorHasSelection"
        },
        {
          "command": "arduinoplus.insertSnippet",
          "group": "2_snippets@3"
        },
        {
          "command": "arduinoplus.openSnippetPanel",
          "group": "2_snippets@4"
        },
        {
          "command": "arduinoplus.setAnchor",
          "group": "3_anchors@1"
        },
        {
          "command": "arduinoplus.insertCommentAnchor",
          "group": "3_anchors@2"
        },
        {
          "command": "arduinoplus.showAnchors",
          "group": "3_anchors@3"
        },
        {
          "command": "arduinoplus.showTodos",
          "group": "4_tools@1"
        },
        {
          "command": "arduinoplus.lcdCharEditor",
          "group": "4_tools@2"
        },
        {
          "command": "arduinoplus.melodyEditor",
          "group": "4_tools@3"
        },
        {
          "command": "arduinoplus.snapshots",
          "group": "5_sketch@1"
        },
        {
          "command": "arduinoplus.print",
          "group": "5_sketch@2"
        },
        {
          "command": "arduinoplus.about",
          "group": "9_about@1"
        }
      ],
      "commandPalette": [
        {
          "command": "arduinoplus.toggleLineComment",
          "when": "!arduinoplus.isVSCode"
        },
        {
          "command": "arduinoplus.duplicateLine",
          "when": "!arduinoplus.isVSCode"
        }
      ]
    }
  },
  "scripts": {
    "package": "vsce package"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NikolaiRadke/Arduinoplus"
  },
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/NikolaiRadke/Arduinoplus/issues"
  },
  "homepage": "https://github.com/NikolaiRadke/Arduinoplus#readme"
}
