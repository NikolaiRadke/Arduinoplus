  "tokenColors": [
    {
      "settings": {
        "foreground": "#e8e8e8"
      }
    },
    {
      "scope": [
        "variable",
        "variable.name",
        "variable.other",
        "punctuation",
        "meta.block"
      ],
      "settings": {
        "foreground": "#e8e8e8"
      }
    },
    {
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier",
        "support.type",
        "support.class",
        "entity.name.type",
        "string.quoted.single.c"
      ],
      "settings": {
        "foreground": "#2fc49b"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.c",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#e69f00"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted.double",
        "string.quoted.single",
        "string.quoted.other.lt-gt"
      ],
      "settings": {
        "foreground": "#e08fc2"
      }
    },
    {
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#f0e442"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.sizeof"
      ],
      "settings": {
        "foreground": "#56b4e9"
      }
    },
    {
      "scope": [
        "meta.preprocessor",
        "meta.preprocessor.c",
        "keyword.control.directive",
        "entity.name.function.preprocessor",
        "entity.name.function.preprocessor.c",
        "meta.preprocessor.macro.c",
        "punctuation.definition.directive"
      ],
      "settings": {
        "foreground": "#56b4e9"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#a0a0a0"
      }
    }
  ]
}
