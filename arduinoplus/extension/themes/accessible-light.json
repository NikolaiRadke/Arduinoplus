  },
  "tokenColors": [
    {
      "settings": {
        "foreground": "#1e1e1e"
      }
    },
    {
      "scope": [
        "variable",
        "variable.name",
        "variable.other",
        "punctuation",
        "meta.block"
      ],
      "settings": {
        "foreground": "#1e1e1e"
      }
    },
    {
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier",
        "support.type",
        "support.class",
        "entity.name.type",
        "string.quoted.single.c"
      ],
      "settings": {
        "foreground": "#00785a",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.c",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#b84f00"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted.double",
        "string.quoted.single",
        "string.quoted.other.lt-gt"
      ],
      "settings": {
        "foreground": "#a0468a"
      }
    },
    {
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#8a6400"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.sizeof"
      ],
      "settings": {
        "foreground": "#0072b2",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "meta.preprocessor",
        "meta.preprocessor.c",
        "keyword.control.directive",
        "entity.name.function.preprocessor",
        "entity.name.function.preprocessor.c",
        "meta.preprocessor.macro.c",
        "punctuation.definition.directive"
      ],
      "settings": {
        "foreground": "#0072b2"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6b6b6b",
        "fontStyle": "italic"
      }
    }
  ]
}
